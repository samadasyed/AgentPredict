# AgentPredict dashboard — production nginx site (TEMPLATE).
#
# Rendered by the stock nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. ${NGINX_LOCAL_RESOLVERS} is exported by the
# image's own 15-local-resolvers.envsh (activated via
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1) from the container's /etc/resolv.conf.
#
# Serves the static Vite build and proxies the data plane to the gateway
# container, so the browser only ever talks to ONE origin:
#   /            → static SPA
#   /ws          → gateway WebSocket (upgrade headers required)
#   /health      → gateway health (also handy for external uptime checks)
#
# The gateway address is deliberately a VARIABLE: nginx then re-resolves it
# per-request (respecting `valid=`) instead of caching the IP once at startup.
# With a static upstream, recreating the gateway container (new IP) left nginx
# proxying to the old IP — the whole public site 502'd until nginx restarted.
#
# TLS terminates in FRONT of this (Cloudflare Tunnel / host proxy / LB) —
# this server only speaks plain HTTP on :80.

server {
    listen 80;
    server_name _;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: unknown paths render the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Immutable fingerprinted assets — cache hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /ws {
        set $gateway_upstream gateway:8000;
        proxy_pass http://$gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Odds can be quiet between polls — don't reap idle-but-healthy sockets.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /health {
        set $gateway_upstream gateway:8000;
        proxy_pass http://$gateway_upstream;
        proxy_set_header Host $host;
    }
}
