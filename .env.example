# ─── Offline / demo mode ──────────────────────────────────────────────────────
# Set to "1" to run the whole stack on synthetic data with NO external APIs
# (agents emit fake markets/fights; RAG retrieves+explains without Pinecone/Gemini).
# `make demo` sets this for you via docker-compose.mock.yml — leave it 0 for real data.
MOCK_MODE=0

# ─── gRPC addresses ───────────────────────────────────────────────────────────
ENGINE_GRPC_ADDRESS=localhost:50051
RAG_GRPC_ADDRESS=localhost:50052

# ─── Engine ───────────────────────────────────────────────────────────────────
# Ring-buffer capacity (events retained for live streaming + replay).
# Must be a power of 2 in [1, 16777216]. Default: 4096.
ENGINE_RING_CAPACITY=4096
# Log verbosity for the C++ engine: DEBUG | INFO | WARN | ERROR. Default: INFO.
ENGINE_LOG_LEVEL=INFO

# ─── Gateway ──────────────────────────────────────────────────────────────────
# URL the browser uses to open the WebSocket connection.
GATEWAY_WS_URL=ws://localhost:8000/ws

# ─── AI / Vector Store ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentpredict

# ─── BallDontLie MMA API ─────────────────────────────────────────────────────
# Free tier: event discovery only.
# GOAT tier ($39.99/mo): fight stats — required to unlock live stat polling.
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here
# Set to "1" to enable GOAT-tier live fight stat polling (requires GOAT subscription).
BALLDONTLIE_GOAT_TIER=0

# ─── Optional dev flags ───────────────────────────────────────────────────────
# Set to "1" to dump raw API responses to /tmp/ for debugging.
DEBUG_DUMP=0

# Minimum probability delta to emit a Polymarket event.
POLYMARKET_DELTA_THRESHOLD=0.01

# Track only markets whose question contains this keyword (e.g. "UFC").
# Leave BLANK to track all currently-live markets (more movement, off-theme).
POLYMARKET_QUERY=UFC
# Max markets to price each poll (get_prices is one request per market).
POLYMARKET_MAX_MARKETS=30
# Window of price history pulled for the pre-event odds-trend chart (CLOB
# prices-history `interval`: e.g. 1d, 1w, 1m, max).
POLYMARKET_HISTORY_INTERVAL=1w

# Poll interval in seconds for each agent.
POLYMARKET_POLL_INTERVAL_S=5
MMA_POLL_INTERVAL_S=30
